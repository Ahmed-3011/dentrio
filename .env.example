# Auth & Database
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Public app URL used in verification emails (no trailing slash)
# Dev: http://localhost:3000  |  Prod: https://yourapp.example.com
APP_URL=

# Resend API key (https://resend.com) + verified "from" email
RESEND_API_KEY=
RESEND_FROM_EMAIL=Dentrio <onboarding@resend.dev>

# Vercel Blob storage for scans/photos/attachments (optional locally).
# Set automatically when you connect a Blob store to the Vercel project.
# When present, uploads go to Blob; when absent, they are written to ./uploads.
BLOB_READ_WRITE_TOKEN=